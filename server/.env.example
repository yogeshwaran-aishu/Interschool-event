# Copy to .env. Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://isc:isc@localhost:5433/interschool
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:4200
# Runs the job worker inside the API process (handy locally; use `npm run worker` in production).
RUN_WORKER_IN_API=true
# Password given to people created by an admin. Leave empty in production: a random one is emailed.
INITIAL_PASSWORD=demo1234
# Allows POST /api/v1/dev/reset (re-seeds the demo data). Never enable in production.
ALLOW_DEMO_RESET=true
# SMTP for email. Empty = log emails to the console (e.g. use Mailpit: smtp://localhost:1025).
SMTP_URL=
MAIL_FROM="InterSchool Connect <no-reply@interschool.test>"
LOG_LEVEL=info
# Public URL of the Angular app, used in email links.
APP_URL=http://localhost:4200
